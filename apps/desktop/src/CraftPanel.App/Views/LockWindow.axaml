<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CraftPanel.App.Controls"
        x:Class="CraftPanel.App.Views.LockWindow"
        Title="OMNIServers" Width="380" Height="380" CanResize="False" WindowStartupLocation="CenterScreen"
        Icon="avares://CraftPanel/Assets/icon.png">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Width="280">
    <Image Source="avares://CraftPanel/Assets/glyph.png" Width="64" Height="64" />
    <TextBlock Text="OMNIServers is locked" Classes="h2" HorizontalAlignment="Center" />
    <TextBox Name="PinBox" PasswordChar="*" PlaceholderText="PIN or password" HorizontalContentAlignment="Center" />
    <TextBlock Name="ErrorText" Classes="bad small" HorizontalAlignment="Center" IsVisible="False" />
    <Button Name="UnlockButton" Classes="primary lg" Content="Unlock" HorizontalAlignment="Stretch" />
  </StackPanel>
</Window>
